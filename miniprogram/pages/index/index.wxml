<!-- 冷库冷量计算小程序 - 主页面 -->
<view class="page">
  <view class="header">
    <view class="header-title">❄️ 冷库冷量计算软件</view>
    <view class="header-subtitle">专业冷库热负荷计算 · 制冷设备选型参考</view>
  </view>

  <scroll-view scroll-x class="tab-bar" enhanced show-scrollbar="{{false}}">
    <view class="tab-inner">
      <view wx:for="{{tabs}}" wx:key="key" class="tab-item {{activeTab === item.key ? 'active' : ''}}" data-tab="{{item.key}}" bindtap="switchTab">{{item.label}}</view>
    </view>
  </scroll-view>

  <!-- 基本信息 -->
  <view class="tab-content" wx:if="{{activeTab === 'basic'}}">
    <view class="card">
      <view class="card-title">库房基本信息</view>
      <view class="form-item"><view class="form-label">库房名称</view><input class="input" value="{{roomName}}" data-field="roomName" bindinput="onTextInput" placeholder="输入库房名称" /></view>
      <view class="form-item"><view class="form-label">库房类型</view><picker mode="selector" range="{{roomTypeOptions}}" value="{{roomTypeIndex}}" bindchange="onRoomTypeChange"><view class="picker-input">{{roomTypeOptions[roomTypeIndex]}}</view></picker></view>
      <view class="form-item"><view class="form-label">库内设计温度 (℃)</view><input class="input" type="digit" value="{{indoorTemp}}" data-field="indoorTemp" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">夏季室外计算温度 (℃)</view><input class="input" type="digit" value="{{outdoorTemp}}" data-field="outdoorTemp" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">室外相对湿度 (%)</view><input class="input" type="digit" value="{{outdoorHumidity}}" data-field="outdoorHumidity" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">库内相对湿度 (%)</view><input class="input" type="digit" value="{{indoorHumidity}}" data-field="indoorHumidity" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">库房长度 (m)</view><input class="input" type="digit" value="{{roomLength}}" data-field="roomLength" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">库房宽度 (m)</view><input class="input" type="digit" value="{{roomWidth}}" data-field="roomWidth" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">库房高度 (m)</view><input class="input" type="digit" value="{{roomHeight}}" data-field="roomHeight" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">安全系数 (%)</view><input class="input" type="digit" value="{{safetyFactor}}" data-field="safetyFactor" bindinput="onInput" /><view class="form-tip">通常取 5%~15%</view></view>
      <view class="info-box">
        <view class="info-row"><text class="info-label">库房容积：</text><text class="info-value">{{roomVolume}} m³</text></view>
        <view class="info-row"><text class="info-label">库房总面积（六面）：</text><text class="info-value">{{totalArea}} m²</text></view>
      </view>
    </view>
  </view>

  <!-- 围护结构 -->
  <view class="tab-content" wx:if="{{activeTab === 'envelope'}}">
    <view class="card">
      <view class="card-title">围护结构传热负荷计算</view>
      <view class="desc">Q₁ = K × F × Δt × α</view>
      <view class="preset-box">
        <view class="preset-title">🔧 保温材料统一设置</view>
        <view class="form-item"><view class="form-label">保温板材类型</view><picker mode="selector" range="{{materialOptions}}" range-key="label" value="{{presetMaterialIndex}}" bindchange="onPresetMaterialChange"><view class="picker-input">{{materialOptions[presetMaterialIndex].label}}</view></picker></view>
        <view class="form-item"><view class="form-label">保温层厚度 (mm)</view><picker mode="selector" range="{{thicknessOptions}}" value="{{presetThicknessIndex}}" bindchange="onPresetThicknessChange"><view class="picker-input">{{thicknessOptions[presetThicknessIndex]}} mm</view></picker></view>
        <view class="btn btn-primary btn-block" bindtap="applyPresetToAll">一键应用到所有部位</view>
        <view class="k-preview">当前配置理论传热系数 K = <text class="k-value">{{presetK}}</text> W/(m²·K)</view>
      </view>

      <view class="section-title">各部位保温配置</view>

      <view class="config-row">
        <view class="config-header"><text class="config-title">🏠 屋顶/顶棚</text><text class="config-area">面积：{{roofArea}} m²</text></view>
        <view class="form-item"><view class="form-label">保温板材类型</view><picker mode="selector" range="{{materialOptions}}" range-key="label" value="{{roofMaterialIndex}}" data-part="roof" bindchange="onMaterialChange"><view class="picker-input">{{materialOptions[roofMaterialIndex].label}}</view></picker></view>
        <view class="form-item"><view class="form-label">保温层厚度 (mm)</view><picker mode="selector" range="{{thicknessOptions}}" value="{{roofThicknessIndex}}" data-part="roof" bindchange="onThicknessChange"><view class="picker-input">{{thicknessOptions[roofThicknessIndex]}} mm</view></picker></view>
        <view class="form-item"><view class="form-label">传热系数 K [W/(m²·K)]</view><input class="input" type="digit" value="{{roofK}}" data-field="roofK" bindinput="onInput" /><view class="form-tip">自动计算，可手动微调</view></view>
        <view class="form-item"><view class="form-label">太阳辐射修正α</view><picker mode="selector" range="{{roofAlphaOptions}}" value="{{roofAlphaIndex}}" bindchange="onRoofAlphaChange"><view class="picker-input">{{roofAlphaOptions[roofAlphaIndex]}}</view></picker></view>
      </view>

      <view class="config-row">
        <view class="config-header"><text class="config-title">🧱 外墙（四面）</text><text class="config-area">面积：{{wallArea}} m²</text></view>
        <view class="form-item"><view class="form-label">保温板材类型</view><picker mode="selector" range="{{materialOptions}}" range-key="label" value="{{wallMaterialIndex}}" data-part="wall" bindchange="onMaterialChange"><view class="picker-input">{{materialOptions[wallMaterialIndex].label}}</view></picker></view>
        <view class="form-item"><view class="form-label">保温层厚度 (mm)</view><picker mode="selector" range="{{thicknessOptions}}" value="{{wallThicknessIndex}}" data-part="wall" bindchange="onThicknessChange"><view class="picker-input">{{thicknessOptions[wallThicknessIndex]}} mm</view></picker></view>
        <view class="form-item"><view class="form-label">传热系数 K [W/(m²·K)]</view><input class="input" type="digit" value="{{wallK}}" data-field="wallK" bindinput="onInput" /><view class="form-tip">自动计算，可手动微调</view></view>
        <view class="form-item"><view class="form-label">修正系数α</view><picker mode="selector" range="{{wallAlphaOptions}}" value="{{wallAlphaIndex}}" bindchange="onWallAlphaChange"><view class="picker-input">{{wallAlphaOptions[wallAlphaIndex]}}</view></picker></view>
      </view>

      <view class="config-row">
        <view class="config-header"><text class="config-title">⬇️ 地板</text><text class="config-area">面积：{{floorArea}} m²</text></view>
        <view class="form-item"><view class="form-label">保温板材类型</view><picker mode="selector" range="{{materialOptions}}" range-key="label" value="{{floorMaterialIndex}}" data-part="floor" bindchange="onMaterialChange"><view class="picker-input">{{materialOptions[floorMaterialIndex].label}}</view></picker></view>
        <view class="form-item"><view class="form-label">保温层厚度 (mm)</view><picker mode="selector" range="{{thicknessOptions}}" value="{{floorThicknessIndex}}" data-part="floor" bindchange="onThicknessChange"><view class="picker-input">{{thicknessOptions[floorThicknessIndex]}} mm</view></picker></view>
        <view class="form-item"><view class="form-label">传热系数 K [W/(m²·K)]</view><input class="input" type="digit" value="{{floorK}}" data-field="floorK" bindinput="onInput" /><view class="form-tip">自动计算，可手动微调</view></view>
        <view class="form-item"><view class="form-label">地板类型</view><picker mode="selector" range="{{floorTypeOptions}}" value="{{floorTypeIndex}}" bindchange="onFloorTypeChange"><view class="picker-input">{{floorTypeOptions[floorTypeIndex]}}</view></picker></view>
      </view>

      <view class="config-row">
        <view class="config-header"><text class="config-title">🚪 隔墙（与邻室）</text><text class="config-area">面积：{{partitionArea}} m²</text></view>
        <view class="form-item"><view class="form-label">隔墙面积 (m²)</view><input class="input" type="digit" value="{{partitionArea}}" data-field="partitionArea" bindinput="onInput" /><view class="form-tip">有邻室时填写，无则为0</view></view>
        <view class="form-item"><view class="form-label">保温板材类型</view><picker mode="selector" range="{{materialOptions}}" range-key="label" value="{{partitionMaterialIndex}}" data-part="partition" bindchange="onMaterialChange"><view class="picker-input">{{materialOptions[partitionMaterialIndex].label}}</view></picker></view>
        <view class="form-item"><view class="form-label">保温层厚度 (mm)</view><picker mode="selector" range="{{thicknessOptions}}" value="{{partitionThicknessIndex}}" data-part="partition" bindchange="onThicknessChange"><view class="picker-input">{{thicknessOptions[partitionThicknessIndex]}} mm</view></picker></view>
        <view class="form-item"><view class="form-label">传热系数 K [W/(m²·K)]</view><input class="input" type="digit" value="{{partitionK}}" data-field="partitionK" bindinput="onInput" /></view>
        <view class="form-item"><view class="form-label">邻室温度 (℃)</view><input class="input" type="digit" value="{{adjacentTemp}}" data-field="adjacentTemp" bindinput="onInput" /></view>
      </view>

      <view class="section-title">📊 围护结构传热计算结果</view>
      <view class="table-wrap">
        <view class="table-header">
          <text class="th th-name">部位</text><text class="th">面积</text><text class="th">材料</text>
          <text class="th">厚度</text><text class="th">K值</text><text class="th">温差</text><text class="th">α</text><text class="th">传热量(W)</text>
        </view>
        <view class="table-row" wx:for="{{envelopeRows}}" wx:key="name">
          <text class="td td-name">{{item.name}}</text><text class="td">{{item.area}}</text><text class="td td-mat">{{item.material}}</text>
          <text class="td">{{item.thickness}}</text><text class="td">{{item.k}}</text><text class="td">{{item.delta}}</text>
          <text class="td">{{item.alpha}}</text><text class="td td-load">{{item.load}}</text>
        </view>
        <view class="table-total">
          <text class="total-label">围护结构总传热负荷</text>
          <text class="total-value">{{envelopeTotal}} W / {{envelopeTotalKW}} kW</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 货物负荷 -->
  <view class="tab-content" wx:if="{{activeTab === 'goods'}}">
    <view class="card">
      <view class="card-title">货物冷负荷计算</view>
      <view class="desc">包含货物冷却、冻结潜热、包装材料及运载工具的热量</view>
      <view class="form-item"><view class="form-label">每日进货量 (kg/d)</view><input class="input" type="digit" value="{{goodsMass}}" data-field="goodsMass" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">货物进货温度 (℃)</view><input class="input" type="digit" value="{{goodsInTemp}}" data-field="goodsInTemp" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">货物终温 (℃)</view><input class="input" type="digit" value="{{goodsOutTemp}}" data-field="goodsOutTemp" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">货物冻结点温度 (℃)</view><input class="input" type="digit" value="{{freezePoint}}" data-field="freezePoint" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">冻结前比热容 [kJ/(kg·K)]</view><input class="input" type="digit" value="{{cpAbove}}" data-field="cpAbove" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">冻结后比热容 [kJ/(kg·K)]</view><input class="input" type="digit" value="{{cpBelow}}" data-field="cpBelow" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">货物潜热 (kJ/kg)</view><input class="input" type="digit" value="{{latentHeat}}" data-field="latentHeat" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">货物冷却时间 (h)</view><input class="input" type="digit" value="{{coolingTime}}" data-field="coolingTime" bindinput="onInput" /></view>
      <view class="section-title">包装及运载工具</view>
      <view class="form-item"><view class="form-label">包装材料质量 (kg/d)</view><input class="input" type="digit" value="{{packMass}}" data-field="packMass" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">包装比热容 [kJ/(kg·K)]</view><input class="input" type="digit" value="{{packCp}}" data-field="packCp" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">包装初始温度 (℃)</view><input class="input" type="digit" value="{{packTemp}}" data-field="packTemp" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">运载工具质量 (kg/次)</view><input class="input" type="digit" value="{{containerMass}}" data-field="containerMass" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">运载工具比热容 [kJ/(kg·K)]</view><input class="input" type="digit" value="{{containerCp}}" data-field="containerCp" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">每日进货次数</view><input class="input" type="digit" value="{{containerTimes}}" data-field="containerTimes" bindinput="onInput" /></view>
      <view class="result-summary">
        <view class="result-title">货物总冷负荷：{{goodsTotal}} W = {{goodsTotalKW}} kW</view>
        <view class="breakdown">
          <view class="breakdown-item">货物显热（冷却）：{{goodsSensible}} W</view>
          <view class="breakdown-item">货物潜热（冻结）：{{goodsLatent}} W</view>
          <view class="breakdown-item">包装材料冷负荷：{{packLoad}} W</view>
          <view class="breakdown-item">运载工具冷负荷：{{containerLoad}} W</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 通风换气 -->
  <view class="tab-content" wx:if="{{activeTab === 'ventilation'}}">
    <view class="card">
      <view class="card-title">通风换气冷负荷计算</view>
      <view class="desc">Q₃ = n·V·ρ·(h_w - h_n) / 3600</view>
      <view class="form-item"><view class="form-label">换气次数 (次/日)</view><input class="input" type="digit" value="{{airChanges}}" data-field="airChanges" bindinput="onInput" /><view class="form-tip">冷藏库2~4次，冷冻库1~2次</view></view>
      <view class="form-item"><view class="form-label">空气密度 (kg/m³)</view><input class="input" type="digit" value="{{airDensity}}" data-field="airDensity" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">每日开门通风时间 (h)</view><input class="input" type="digit" value="{{ventTime}}" data-field="ventTime" bindinput="onInput" /></view>
      <view class="info-box">
        <view class="section-subtitle">焓值参考（自动计算）</view>
        <view class="info-row"><text class="info-label">室外空气焓值 h_w：</text><text class="info-value">{{outdoorEnthalpy}} kJ/kg</text></view>
        <view class="info-row"><text class="info-label">室内空气焓值 h_n：</text><text class="info-value">{{indoorEnthalpy}} kJ/kg</text></view>
        <view class="info-row"><text class="info-label">焓差 Δh：</text><text class="info-value">{{enthalpyDiff}} kJ/kg</text></view>
      </view>
      <view class="result-summary"><view class="result-title">通风换气总冷负荷：{{ventTotal}} W = {{ventTotalKW}} kW</view></view>
    </view>
  </view>

  <!-- 操作管理 -->
  <view class="tab-content" wx:if="{{activeTab === 'operation'}}">
    <view class="card">
      <view class="card-title">操作管理冷负荷</view>
      <view class="section-title">人员散热</view>
      <view class="form-item"><view class="form-label">库内工作人员数量 (人)</view><input class="input" type="digit" value="{{personCount}}" data-field="personCount" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">每人散热量 (W/人)</view><input class="input" type="digit" value="{{personHeat}}" data-field="personHeat" bindinput="onInput" /><view class="form-tip">轻度劳动280W，中度劳动420W</view></view>
      <view class="form-item"><view class="form-label">人员每日在库时间 (h)</view><input class="input" type="digit" value="{{personTime}}" data-field="personTime" bindinput="onInput" /></view>
      <view class="section-title">照明散热</view>
      <view class="form-item"><view class="form-label">照明功率密度 (W/m²)</view><input class="input" type="digit" value="{{lightingDensity}}" data-field="lightingDensity" bindinput="onInput" /><view class="form-tip">一般冷库3~5 W/m²</view></view>
      <view class="form-item"><view class="form-label">每日照明时间 (h)</view><input class="input" type="digit" value="{{lightingTime}}" data-field="lightingTime" bindinput="onInput" /></view>
      <view class="section-title">设备散热</view>
      <view class="form-item"><view class="form-label">库内设备总功率 (kW)</view><input class="input" type="digit" value="{{equipmentPower}}" data-field="equipmentPower" bindinput="onInput" /><view class="form-tip">如叉车、分拣设备等</view></view>
      <view class="form-item"><view class="form-label">设备同时使用系数</view><input class="input" type="digit" value="{{equipmentDiversity}}" data-field="equipmentDiversity" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">设备每日运行时间 (h)</view><input class="input" type="digit" value="{{equipmentTime}}" data-field="equipmentTime" bindinput="onInput" /></view>
      <view class="section-title">开门热负荷</view>
      <view class="form-item"><view class="form-label">冷库门面积 (m²)</view><input class="input" type="digit" value="{{doorArea}}" data-field="doorArea" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">每日开门次数 (次)</view><input class="input" type="digit" value="{{doorOpens}}" data-field="doorOpens" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">每次开门时间 (s)</view><input class="input" type="digit" value="{{doorDuration}}" data-field="doorDuration" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">门洞传热系数 [W/(m²·K)]</view><input class="input" type="digit" value="{{doorK}}" data-field="doorK" bindinput="onInput" /></view>
      <view class="result-summary">
        <view class="result-title">操作管理总冷负荷：{{operationTotal}} W = {{operationTotalKW}} kW</view>
        <view class="breakdown">
          <view class="breakdown-item">人员散热：{{personTotal}} W</view>
          <view class="breakdown-item">照明散热：{{lightingTotal}} W</view>
          <view class="breakdown-item">设备散热：{{equipmentTotal}} W</view>
          <view class="breakdown-item">开门热负荷：{{doorTotal}} W</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 电机热负荷 -->
  <view class="tab-content" wx:if="{{activeTab === 'motor'}}">
    <view class="card">
      <view class="card-title">电机运行热负荷</view>
      <view class="desc">库内风机、电机等设备运行时产生的热量</view>
      <view class="form-item"><view class="form-label">冷风机电机总功率 (kW)</view><input class="input" type="digit" value="{{fanMotorPower}}" data-field="fanMotorPower" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">电机热转化系数</view><input class="input" type="digit" value="{{motorEfficiency}}" data-field="motorEfficiency" bindinput="onInput" /><view class="form-tip">电机在库内取0.7~0.85</view></view>
      <view class="form-item"><view class="form-label">每日运行时间 (h)</view><input class="input" type="digit" value="{{motorTime}}" data-field="motorTime" bindinput="onInput" /></view>
      <view class="form-item"><view class="form-label">其他库内电机功率 (kW)</view><input class="input" type="digit" value="{{otherMotorPower}}" data-field="otherMotorPower" bindinput="onInput" /></view>
      <view class="result-summary"><view class="result-title">电机总热负荷：{{motorTotal}} W = {{motorTotalKW}} kW</view></view>
    </view>
  </view>

  <!-- 计算结果 -->
  <view class="tab-content" wx:if="{{activeTab === 'result'}}">
    <view class="card">
      <view class="card-title">📊 冷量计算结果汇总</view>
      <view class="result-main">
        <view class="result-row"><text class="row-label">① 围护结构传热负荷</text><text class="row-value">{{r1}} kW</text><text class="row-percent">{{r1p}}</text></view>
        <view class="result-row"><text class="row-label">② 货物冷负荷</text><text class="row-value">{{r2}} kW</text><text class="row-percent">{{r2p}}</text></view>
        <view class="result-row"><text class="row-label">③ 通风换气冷负荷</text><text class="row-value">{{r3}} kW</text><text class="row-percent">{{r3p}}</text></view>
        <view class="result-row"><text class="row-label">④ 操作管理冷负荷</text><text class="row-value">{{r4}} kW</text><text class="row-percent">{{r4p}}</text></view>
        <view class="result-row"><text class="row-label">⑤ 电机运行热负荷</text><text class="row-value">{{r5}} kW</text><text class="row-percent">{{r5p}}</text></view>
        <view class="result-row total-row"><text class="row-label">计算总冷负荷</text><text class="row-value">{{rTotal}} kW</text><text class="row-percent">100%</text></view>
        <view class="result-row grand-total"><text class="row-label">设计冷量（含安全系数）</text><text class="row-value">{{rDesign}} kW</text></view>
      </view>
      <view class="chart-box">
        <view class="section-title">负荷构成比例</view>
        <view class="bar-chart">
          <view class="bar-row" wx:for="{{barData}}" wx:key="label">
            <text class="bar-label">{{item.label}}</text>
            <view class="bar-track">
              <view class="bar-fill" style="width: {{item.pct}}%; background: {{item.color}};">
                <text class="bar-text">{{item.kw}}kW</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="selection-box">
        <view class="section-title">🔧 制冷设备选型参考</view>
        <view class="form-item"><view class="form-label">蒸发温度 (℃)</view><input class="input" type="digit" value="{{evapTemp}}" data-field="evapTemp" bindinput="onInput" /><view class="form-tip">通常比库温低7~10℃</view></view>
        <view class="form-item"><view class="form-label">冷凝温度 (℃)</view><input class="input" type="digit" value="{{condTemp}}" data-field="condTemp" bindinput="onInput" /></view>
        <view class="form-item"><view class="form-label">制冷系数 COP（参考）</view><input class="input" type="digit" value="{{copValue}}" data-field="copValue" bindinput="onInput" /></view>
        <view class="info-box">
          <view class="info-row"><text class="info-label">所需压缩机轴功率：</text><text class="info-value">{{compressorPower}} kW</text></view>
          <view class="info-row"><text class="info-label">建议配置制冷量：</text><text class="info-value">{{suggestedCapacity}} kW</text></view>
          <view class="info-row"><text class="info-label">冷风机建议配置：</text><text class="info-value">{{fanSuggestion}} kW（1.2倍余量）</text></view>
        </view>
      </view>
      <view class="action-buttons">
        <view class="btn btn-primary" bindtap="exportReport">📄 导出计算报告</view>
        <view class="btn btn-secondary" bindtap="resetAll">🔄 重置参数</view>
      </view>
    </view>
  </view>

  <view class="footer">
    <view class="footer-company">
      <view class="footer-name">{{companyName}}</view>
      <view class="footer-desc">专业冷库设计 · 安装 · 节能改造一站式服务</view>
    </view>
    <view class="footer-contact" bindtap="makeCall"><text class="footer-phone">📞 电话/微信：{{companyPhone}}</text></view>
    <view class="footer-address">📍 地址：{{companyAddress}}</view>
    <view class="footer-version">冷库冷量计算软件 v2.0 小程序版 | 依据 GB 50072 编制</view>
    <view class="footer-disclaimer">本软件计算结果仅供参考，实际工程设计请由专业制冷工程师审核确认。</view>
  </view>
</view>
